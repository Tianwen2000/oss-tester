# Copy this file to .env locally. Replace the endpoint, region, and bucket, then
# choose one credential method below. Never commit .env or real credentials.
OSS_ENDPOINT=https://s3.example.invalid
OSS_REGION=replace-with-region
OSS_BUCKET=replace-with-dedicated-test-bucket

# Method A: fill both values with credentials scoped to the dedicated test bucket.
# Empty values are ignored, so leaving them blank allows the boto3 provider chain.
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=

# Method B: leave Method A blank and select an AWS shared credentials profile.
# AWS_PROFILE=replace-with-safe-profile

# Method C: leave both methods above blank and use a workload/instance role or
# credentials injected into the process environment by a secret manager.
