# Copy to .env locally and replace every placeholder with the dedicated test
# bucket values. Never commit .env, AK, SK, session tokens or private endpoints.
OSS_ENDPOINT=https://s3.example.invalid
OSS_REGION=replace-with-region
OSS_BUCKET=replace-with-dedicated-test-bucket

# Optional legacy variable names. Prefer an AWS shared credentials profile,
# environment variables injected by the secret manager, or a workload role.
# OSS_ACCESS_KEY_ID=replace-locally
# OSS_SECRET_ACCESS_KEY=replace-locally
# AWS_PROFILE=replace-with-safe-profile
